APP_NAME=local-document-qa
ENVIRONMENT=development

QDRANT_HOST=localhost
QDRANT_PORT=6333
# Set this to run Qdrant embedded (on-disk, no server/Docker needed) —
# useful for local development. Leave unset for docker-compose deployments.
# QDRANT_STORAGE_PATH=./qdrant_data

MAX_UPLOAD_SIZE_BYTES=20971520

CHUNKING_MAX_TOKENS=500
CHUNKING_OVERLAP_TOKENS=75

EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

RETRIEVAL_TOP_K=10
LLM_CONTEXT_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=0.5  # unset (commented out) = no threshold filtering
RETRIEVAL_MAX_OVERLAP_RATIO=0.8

RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
ENABLE_RERANKER=false

# LM Studio (or another OpenAI-compatible local server). When running the
# API in Docker Compose, this is overridden to http://host.docker.internal:1234
# by default (see docker-compose.yml) since LM Studio runs on the host.
LLM_BASE_URL=http://localhost:1234
LLM_MODEL_ID=qwen/qwen3.5-4b
LLM_TEMPERATURE=0.0
LLM_TOP_P=1.0
LLM_MAX_NEW_TOKENS=2048
LLM_CONTEXT_TOKEN_LIMIT=3000
LLM_TIMEOUT_SECONDS=60.0

# Optional: a model_id starting with "gemini" routes to the Gemini API
# instead of LM Studio (get an API key at https://aistudio.google.com/apikey).
# Current Gemini models think by default and that counts against
# LLM_MAX_NEW_TOKENS, so keep this generous or the answer gets crowded out.
# GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-flash-latest
